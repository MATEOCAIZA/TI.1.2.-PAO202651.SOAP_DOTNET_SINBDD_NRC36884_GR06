<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLIMOV_CONUNI_SOAPDOTNET_GR01.Pages.LoginPage"
             BackgroundColor="#F4F0FF"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="300,*">
            <!-- Imagen de cabecera a todo lo ancho -->
            <Image Source="monster_door.jpg" Aspect="AspectFill" />
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#003B1F7A" Offset="0.4" />
                        <GradientStop Color="#F4F0FF" Offset="1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Tarjeta de login que se monta sobre la imagen -->
            <Border Grid.Row="1"
                    Margin="20,-70,20,24"
                    BackgroundColor="White"
                    Stroke="#E4DBFF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="26"
                    VerticalOptions="Start"
                    MaximumWidthRequest="440">
                <Border.Shadow>
                    <Shadow Brush="#5B3BD1" Opacity="0.18" Radius="24" Offset="0,8" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="#EDE6FF" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4" HorizontalOptions="Start" Margin="0,0,0,12">
                        <Label Text="SOAP · .NET" TextColor="#6A3FE0" FontSize="12" FontAttributes="Bold" />
                    </Border>

                    <Label Text="¡Hola, asustador!"
                           FontAttributes="Bold"
                           FontSize="26"
                           TextColor="#24124F" />
                    <Label Text="Inicia sesion para convertir unidades"
                           FontSize="14"
                           TextColor="#7A6F99"
                           Margin="0,2,0,20" />

                    <Label Text="Usuario" FontSize="13" TextColor="#4B3D73" FontAttributes="Bold" Margin="0,0,0,6" />
                    <Border Stroke="#DCD2F7" StrokeShape="RoundRectangle 14" BackgroundColor="#FAF8FF" Padding="12,2" Margin="0,0,0,14">
                        <Entry x:Name="UsernameEntry" Placeholder="Ingrese su usuario" TextColor="#24124F" PlaceholderColor="#A79FC2" ClearButtonVisibility="WhileEditing" HeightRequest="46" />
                    </Border>

                    <Label Text="Contraseña" FontSize="13" TextColor="#4B3D73" FontAttributes="Bold" Margin="0,0,0,6" />
                    <Border Stroke="#DCD2F7" StrokeShape="RoundRectangle 14" BackgroundColor="#FAF8FF" Padding="12,2" Margin="0,0,0,10">
                        <Entry x:Name="PasswordEntry" Placeholder="Ingrese su contraseña" IsPassword="True" TextColor="#24124F" PlaceholderColor="#A79FC2" HeightRequest="46" />
                    </Border>

                    <Label x:Name="ErrorLabel"
                           TextColor="#D6336C"
                           FontSize="13"
                           Margin="0,0,0,12"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Ingresar"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#6A3FE0"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="26"
                            HeightRequest="52" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
