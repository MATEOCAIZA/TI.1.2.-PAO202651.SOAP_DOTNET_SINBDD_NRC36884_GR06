<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://ec.edu.monster/servicio" elementFormDefault="qualified" targetNamespace="http://ec.edu.monster/servicio" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Convert">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="category" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="fromUnit" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="toUnit" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="value" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ConvertResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="ConvertResult" type="xs:double" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>